{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "mpicxx build active file",
      "command": "/usr/lib64/openmpi/bin/mpicxx",
      "args": [
        "-g", "${file}",
        "-std=c++17",
        "-I", "${workspaceFolder}/include",
        "-o", "${fileDirname}/${fileBasenameNoExtension}.o"
      ],
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
    },
  ]
}